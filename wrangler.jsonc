{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sabah-bio",
  "compatibility_date": "2026-09-22",

  // Roda antes de `wrangler deploy` / `wrangler dev`, inclusive no Workers Builds.
  "build": {
    "command": "npm run build"
  },

  // Site estático (assets-only). dist/ é gerado pelo Vite (base em src/config.ts).
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }

  // ---------------------------------------------------------------------------
  // DOMÍNIO FINAL: links.sabah.com.br
  //
  // Opção A (recomendada): painel Cloudflare → Workers & Pages → sabah-bio →
  // Settings → Domains & Routes → Add → Custom domain → links.sabah.com.br.
  // O painel cria o DNS e o certificado e valida que a zona está nesta conta.
  //
  // Opção B: descomentar abaixo e fazer push. Só funciona se a zona
  // sabah.com.br estiver NESTA conta Cloudflare; caso contrário o deploy
  // automático falha.
  //
  // "routes": [
  //   { "pattern": "links.sabah.com.br", "custom_domain": true }
  // ]
  // ---------------------------------------------------------------------------
}

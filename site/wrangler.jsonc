{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sabah-site",
  "compatibility_date": "2026-11-01",

  // Roda antes de `wrangler deploy` / `wrangler dev`, inclusive no Workers Builds.
  "build": {
    "command": "npm run build"
  },

  // Worker mínimo: só atende /video/*, para entregar os vídeos em trechos (206), que o
  // Safari exige e os arquivos estáticos do Workers não fazem. Ver worker/index.js.
  "main": "worker/index.js",

  // O resto do site é estático: sai direto de dist/, sem passar pelo Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/video/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // ---------------------------------------------------------------------------
  // DOMÍNIO OFICIAL: https://sabah.com.br (no ar desde 26/11/2026)
  //
  // É uma ROTA, não um "custom domain", de propósito. O e-mail do Sabah fica no
  // servidor antigo (VPS com cPanel) e o MX depende do registro DNS do domínio.
  // Um custom domain trocaria esse registro e a entrada de e-mails pararia. A rota
  // não toca no DNS: o registro continua apontando para o servidor antigo e o
  // Cloudflare só entrega este site no lugar do WordPress.
  //
  // Só HTTPS e só o domínio sem www, também de propósito:
  //  - http://sabah.com.br continua no servidor antigo, que redireciona para https e
  //    responde a validação do certificado usado pelo e-mail e pelo webmail
  //    (Let's Encrypt, /.well-known/acme-challenge/ na porta 80);
  //  - www.sabah.com.br continua no servidor antigo, que redireciona para sabah.com.br;
  //  - webmail.sabah.com.br, cpanel.sabah.com.br e mail.sabah.com.br não passam por aqui.
  //
  // Para voltar ao site antigo: painel Cloudflare → Workers & Pages → sabah-site →
  // Settings → Domains & Routes → remover a rota. O WordPress volta a responder na hora.
  // Detalhes no README, em "Domínio oficial e e-mail".
  // ---------------------------------------------------------------------------
  "routes": [
    { "pattern": "https://sabah.com.br/*", "zone_name": "sabah.com.br" }
  ]
}
